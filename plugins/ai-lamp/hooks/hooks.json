{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "work"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "work"
            ],
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "ask"
            ],
            "async": true
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "done"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "done"
            ],
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "ask"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd",
            "args": [
              "/d",
              "/c",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lamp-hook.cmd",
              "end"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
